{
  "name": "sech-lims-by-nickland",
  "version": "0.1.0",
  "description": "Foundation MVP scaffold for SECH_LIMS by Nickland, an offline-first LAN-ready Laboratory Quality Management System.",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "tsx watch server/index.ts",
    "dev:electron": "wait-on tcp:5173 tcp:4317 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 API_PORT=4317 electron .",
    "api": "tsx server/index.ts",
    "start:api": "node --experimental-specifier-resolution=node dist-server/server/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-check.mjs",
    "rebuild:native": "electron-builder install-app-deps",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "archiver": "latest",
    "bcryptjs": "latest",
    "better-sqlite3": "11.7.0",
    "cors": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "multer": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "32.3.3",
    "electron-builder": "25.1.8",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.nickland.sechlims",
    "productName": "SECH_LIMS by Nickland",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "server/**/*.{js,ts,json}",
      "shared/**/*.{js,ts,json}",
      "package.json",
      "!**/*.test.*",
      "!**/__tests__/**"
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "npmRebuild": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SECH_LIMS-by-Nickland-${version}-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SECH_LIMS by Nickland"
    }
  }
}
