{
  "name": "sech-lims-by-nickland",
  "version": "0.1.0",
  "description": "Foundation MVP scaffold for SECH_LIMS by Nickland, an offline-first LAN-ready Laboratory Quality Management System.",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "tsx watch server/index.ts",
    "dev:electron": "wait-on tcp:5173 tcp:4317 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 API_PORT=4317 electron .",
    "api": "tsx server/index.ts",
    "start:api": "node --experimental-specifier-resolution=node dist-server/server/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json && node scripts/copy-preload.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-check.mjs",
    "rbac:check": "node scripts/rbac-check.mjs",
    "rbac:levels": "node scripts/rbac-levels.mjs",
    "audit:access": "node scripts/access-audit.mjs",
    "audit:access:live": "node scripts/access-audit-live.mjs",
    "audit:controls": "node scripts/access-scan-controls.mjs",
    "audit:reads": "node scripts/access-scan-reads.mjs",
    "audit:cache": "node scripts/access-cache-check.mjs",
    "audit:dashboard": "node scripts/dashboard-perf-check.mjs",
    "check:accounts": "node scripts/account-check.mjs",
    "check:iqc": "node scripts/iqc-check.mjs",
    "check:iqc-targets": "node scripts/iqc-targets-check.mjs",
    "check:unit-equipment": "node scripts/unit-equipment-check.mjs",
    "check:portal-setup": "node scripts/portal-setup-check.mjs",
    "check:routine-work": "node scripts/routine-work-check.mjs",
    "check:log-sheet-time": "node scripts/log-sheet-time-check.mjs",
    "check:bridge": "node scripts/instrument-bridge-check.mjs",
    "check:lhims": "node scripts/lhims-bridge-check.mjs",
    "rebuild:native": "electron-builder install-app-deps",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "build:mobile": "vite build --config vite.mobile.config.ts && node scripts/prepare-capacitor.mjs",
    "build:mobile:vercel": "vite build --config vite.mobile.config.ts && node scripts/prepare-capacitor.mjs && node scripts/prepare-vercel-mobile.mjs",
    "cap:sync": "npm run build:mobile && cap sync",
    "cap:android": "npm run build:mobile && cap sync android && cap open android",
    "cap:ios": "npm run build:mobile && cap sync ios && cap open ios",
    "mobile:assets": "capacitor-assets generate --assetPath build-resources/mobile",
    "check:iqc-io": "node scripts/iqc-io-check.mjs",
    "check:alerts": "tsx scripts/alerts-check.mjs",
    "check:iqc-admin": "node scripts/iqc-admin-check.mjs",
    "check:iqc-report": "node scripts/iqc-report-check.mjs",
    "check:backup": "tsx scripts/backup-check.mjs",
    "check:backup-scheduler": "tsx scripts/backup-scheduler-check.mjs",
    "check:backup-destinations": "tsx scripts/backup-destinations-check.mjs",
    "check:people-office": "node scripts/office-edit-check.mjs",
    "check:complaints": "node scripts/complaints-check.mjs",
    "check:inventory": "node scripts/inventory-check.mjs",
    "check:inventory-records": "node scripts/inventory-records-check.mjs",
    "check:stock": "python3 scripts/stock_control_check.py",
    "check:stock-math": "tsx scripts/stock-math-check.mjs",
    "check:core-docs": "node scripts/core-documents-check.mjs",
    "check:jobs": "node scripts/background-jobs-check.mjs",
    "validate:oq": "node scripts/validation/oq-suite.mjs",
    "validate:pq": "node scripts/validation/pq-recovery.mjs",
    "validate": "npm run validate:oq && npm run validate:pq"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/geolocation": "^6.1.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "adm-zip": "latest",
    "archiver": "latest",
    "bcryptjs": "latest",
    "better-sqlite3": "11.7.0",
    "cors": "latest",
    "express": "latest",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "latest",
    "multer": "latest",
    "pg": "^8.22.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@types/adm-zip": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vercel/node": "^5.8.26",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "32.3.3",
    "electron-builder": "25.1.8",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.nickland.sechlims",
    "productName": "SECH_LIMS by Nickland",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "server/**/*.{js,ts,json}",
      "shared/**/*.{js,ts,json}",
      "package.json",
      "!**/*.test.*",
      "!**/__tests__/**"
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "npmRebuild": true,
    "publish": null,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SECH_LIMS-by-Nickland-${version}-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SECH_LIMS by Nickland"
    }
  }
}
