# The host's own data folder when it is run from the repository rather than
# installed: the database, uploads, and now config/connectivity.json, which
# holds the address and port this machine listens on. Per-machine runtime
# state, never source.
local-data/

# Validation evidence is a retained quality record, not runtime data: the
# objective evidence behind docs/validation/ has to travel with the code it
# validates. Re-included after the runtime `evidence/` and `*.log` rules above.
!docs/validation/evidence/
!docs/validation/evidence/**

# Scratch databases the check scripts build and tear down. access-cache-check
# writes one into the working tree, which is how a probe file came to be
# committed by a `git add -A` that happened to run while it was mid-flight.
.tmp-access-cache-check/

# TransLis renderer build output
dist-translis/
