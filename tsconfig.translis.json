{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-translis-electron",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "translis/electron/**/*.ts",
    "translis/server/**/*.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "src/types/**/*.d.ts"
  ]
}
