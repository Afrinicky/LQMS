# SECH_LIMS host configuration (offline-first hybrid architecture)
# ---------------------------------------------------------------------------
# Reference for every environment variable the host reads. Copy the ones you
# need into the host's environment (system env vars, service definition, or your
# process launcher). Every value below is the built-in default, so an empty
# environment behaves exactly like a classic single-PC offline install.
#
# See docs/HYBRID_ARCHITECTURE_PLAN.md for the full architecture.

# --- Deployment mode --------------------------------------------------------
# local  = single-PC, fully offline (default)
# hybrid = LAN/remote-capable. Can also be toggled at runtime in
#          Settings > System > Connectivity & Mode.
SECH_LIMS_MODE=local

# --- API / network ----------------------------------------------------------
# Bind address for the host API. 127.0.0.1 keeps it private to the host PC.
# Set to 0.0.0.0 to serve desktop and mobile clients over the LAN.
SECH_LIMS_API_HOST=127.0.0.1
API_PORT=4317
# External URL for secure remote access (reverse proxy / VPN / tunnel).
# Reserved for a later phase; leave unset for LAN-only.
# SECH_LIMS_PUBLIC_URL=

# --- Database ---------------------------------------------------------------
# Active driver. Only 'sqlite' is implemented today; 'postgres' is reserved for
# the future cloud (e.g. Neon) backend.
SECH_LIMS_DB_DRIVER=sqlite
# Root directory for the SQLite DB, uploads, evidence and backups.
# SECH_LIMS_DATA_DIR=./local-data
# Explicit SQLite file path (defaults to <data dir>/sech_lims.sqlite).
# SECH_LIMS_DB_PATH=
# Cloud Postgres/Neon connection string. Reserved for a later phase.
# SECH_LIMS_PG_URL=

# --- Synchronization (opt-in; off by default) --------------------------------
# Master switch. When true AND a cloud URL is set, the host replicates syncable
# records to the cloud (push) and merges cloud changes back (pull). The host
# stays fully authoritative and offline-capable; nothing leaves the machine while
# this is false. See docs/CLOUD_SYNC.md.
SECH_LIMS_SYNC_ENABLED=false
# Cloud PostgreSQL connection string the sync engine replicates to (e.g. Neon):
# SECH_LIMS_CLOUD_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
# Sync cycle interval (push + pull) in milliseconds.
SECH_LIMS_SYNC_INTERVAL_MS=60000

# --- Desktop thin client (Electron) -----------------------------------------
# Set on a *client* PC to run the desktop app as a thin client that connects to
# the Host over the LAN instead of embedding its own API. Leave unset on the
# Host PC. Point it at the Host's LAN address:
# SECH_LIMS_HOST_URL=http://192.168.1.50:4317

# --- Client (build-time, Vite) ----------------------------------------------
# Override the API base URL a browser/desktop client should call. Normally
# auto-resolved; set only when hosting the frontend separately from the API.
# VITE_API_BASE_URL=http://HOST-PC-IP:4317/api

# --- Remote Staff Portal (set in the Vercel project, NOT on the Host) --------
# The Vercel deployment (vercel.json + portal/ + api/) serves the staff portal
# backed by Neon. It reads:
#   DATABASE_URL     - the Neon connection string (same DB the Host replicates to)
#   CLOUD_JWT_SECRET - secret used to sign portal login tokens (long & random)
#   CLOUD_API_TOKEN  - OPTIONAL legacy shared read token (per-staff login is
#                      preferred; leave unset once accounts are provisioned)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# CLOUD_JWT_SECRET=choose-a-long-random-secret
# CLOUD_API_TOKEN=optional-legacy-shared-token
#
# Remote staff accounts are provisioned from the HOST (Settings-level API
# /api/remote-access/users), which requires SECH_LIMS_CLOUD_URL to be set above.
